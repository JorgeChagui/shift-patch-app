# Copy to .env (local dev) or set in Vercel (production). Never commit real values.

# Pooled connection (Supabase pooler, port 6543) used at runtime
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Migrations: Supabase session pooler (same pooler host, port 5432, no pgbouncer flag).
# The direct host db.<ref>.supabase.co is IPv6-only and unreachable from WSL, Vercel and GitHub Actions.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres"
# Local-only database used by the test suites (wiped on every run; must be localhost)
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:34322/shiftpatch_test"
# Optional: E2E database (defaults to TEST_DATABASE_URL with the database renamed to shiftpatch_e2e)
# E2E_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:34322/shiftpatch_e2e"
# Secret used to sign JWTs (generate with: openssl rand -base64 32)
JWT_SECRET=""
# Supabase Storage (credential uploads) - server side only
SUPABASE_URL=""
# Supabase secret key (sb_secret_..., replaces the legacy service_role key). Never expose to the browser.
SUPABASE_SECRET_KEY=""

# --- Local development (npm run db:start) ---
# No pooler locally, so both URLs go straight to Postgres. Get SUPABASE_SECRET_KEY from
# `npm run db:status` (SECRET_KEY).
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:34322/postgres"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:34322/postgres"
# SUPABASE_URL="http://127.0.0.1:34321"
